import os
import re

SLUG = re.compile(r'[- a-zA-Z0-9.]+')
SPDX = re.compile(rf'SPDX-License-Identifier:\s+({SLUG.pattern})')
COPYRIGHT = re.compile(r'Copyright\s+\(c\)\s+(\d{4})(?:-(\d{4}))?\s+([a-zA-Z0-9 ,.]+)')

class Language:
    def __init__(self, *comments, shebang=False):
        assert(isinstance(shebang, bool))
        self.__shebang = shebang

        self.__match = []
        self.__copyright_match = []
        for comment in comments:
            (init, fini) = (comment, '')
            if isinstance(comment, tuple):
                (init, fini) = comment

            pattern = rf"^{init}\s*{SPDX.pattern}\s*{fini}\s*$"
            self.__match.append(re.compile(pattern))
            pattern = rf"^{init}\s*{COPYRIGHT.pattern}\s*{fini}\s*$"
            self.__copyright_match.append(re.compile(pattern))

    def license(self, path):
        "Find the license from the SPDX header."
        with open(path) as f:
            lines = f.readlines(1024)
            for line in lines:
                for matcher in self.__match:
                    match = matcher.match(line)
                    if match:
                        return match.group(1)
        return None

    def copyright(self, path):
        "Find the copyright from the file header."
        with open(path) as f:
            lines = f.readlines(1024)
            for line in lines:
                for matcher in self.__copyright_match:
                    match = matcher.match(line)
                    if match:
                        if match.group(2):
                            year = match.group(2)
                        else:
                            year = match.group(1)
                        owner = match.group(3)
                        return (owner, year)
        return (None, None)

class Index:
    INTERPRETERS = {
        'python3': 'python',
        'python2': 'python',
        'python': 'python',
        'ruby': 'ruby',
        'tsm': 'typescript',
        'sh': 'sh',
    }

    EXTENSIONS = {
        '.py': 'python',
        '.proto': 'protobuf',
        '.rs': 'rust',
        '.yml': 'yaml',
        '.yaml': 'yaml',
        '.json': 'json',
        '.toml': 'toml',
        '.md': 'md',
        '.rb': 'ruby',
        '.c': 'c',
        '.h': 'c',
        '.cpp': 'c++',
        '.hpp': 'c++',
        '.cc': 'c++',
        '.hh': 'c++',
        '.cu': 'cuda-c',
        '.cuh': 'cuda-c',
        '.td': 'tablegen',
        '.ts': 'typescript',
        '.sh': 'shell',
    }

    def __init__(self):
        self.__languages = {
            'python': Language('#+', shebang=True),
            'ruby': Language('#+', shebang=True),
            'c': Language('//+', ('/\\*', '\\*/')),
            'c++': Language('//+', ('/\\*', '\\*/')),
            'cuda-c': Language('//+', ('/\\*', '\\*/')),
            'rust': Language('//+', '//!', ('/\\*', '\\*/')),
            'protobuf': Language('//+', '//!', ('/\\*', '\\*/')),
            'tablegen': Language('//+'),
            'typescript': Language('//+', ('/\\*', '\\*/'), shebang=True),
            'shell': Language('#+', shebang=True),
        }

    def language(self, path):
        name = self.EXTENSIONS.get(os.path.splitext(path)[1])
        if name is None:
            interpreter = ""
            with open(path, "rb") as f:
                if f.read(2) == bytearray('#!'.encode('ascii')):
                    # assume a text file and retry as text file
                    try:
                        with open(path, "r") as t:
                            interpreter = t.readline().rstrip().rsplit(os.path.sep)[-1]
                    except:
                        pass
            name = self.INTERPRETERS.get(interpreter)
        return self.__languages.get(name)

    def scan_dir(self, root):
        IGNORE_DIRS = { ".git" }

        for root, dirs, files in os.walk(root):
            # Ignore the specified directories.
            for dir in IGNORE_DIRS.intersection(dirs):
                dirs.remove(dir)

            for file in files:
                path = os.path.join(root, file)

                # If the file is a symlink, don't bother
                if os.path.islink( path ):
                    continue
                # If the file is empty skip.
                if os.path.getsize(path) == 0:
                    continue
                # Find the language of the file.
                language = self.language(path)
                if language is None:
                    continue

                yield path

    def scan_list(self, files):
        for file in files:
            path = file

            # If the file is a symlink, don't bother
            if os.path.islink( path ):
                continue
            # If the file is empty skip.
            if os.path.getsize(path) == 0:
                continue
            # Find the language of the file.
            language = self.language(path)
            if language is None:
                continue

            # Parse the SPDX header and copyright string for the language.
            yield (path, language.license(path), language.copyright(path))

