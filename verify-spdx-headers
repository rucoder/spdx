    import argparse
    from pathlib import Path
    from datetime import datetime

    parser = argparse.ArgumentParser()
    parser.add_argument('--licenses', required=True, help='Comma-separated list of allowed licenses')
    parser.add_argument('--files', required=False, help='Comma-separated list of files to check')
    parser.add_argument('--copyright', required=False, help='the owner of the copyright')

    args = parser.parse_args()
    files_to_check = None
    copyright_owner = None


    if args.copyright:
        copyright_owner = args.copyright

    # Process licenses
    licenses = [license.strip() for license in args.licenses.split(',')]

    # Process files
    if args.files:
        files_to_check = [Path(f) for f in args.files.split(',')]

    # Your verification logic here
    print(f"Allowed licenses: {licenses}")
    print(f"Files to check: {files_to_check}")

    for license in licenses:
        if not SLUG.match(license):
            print("Invalid license '%s'!" % license)
            raise SystemExit(1)

    rv = 0
    index = Index()

    # collect files if the list is not provided
    if not files_to_check:
        files_to_check = index.scan_dir(".")

    if files_to_check:
        # get current year
        current_year = str(datetime.now().year)

        for (path, license, (copyright, year)) in index.scan_list(files_to_check):
            if license not in licenses:
                if license == None:
                    print(f"NO SPDX {path}")
                else:
                    print(f"Invalid license {license:16} {path}")
                rv = 1

            if copyright_owner is not None:
                if copyright is None:
                    print(f"NO COPYRIGHT {path}")
                elif copyright != copyright_owner:
                    print(f"Copyright mismatch {path} {copyright}")
                    if year is None:
                        print(f"NO YEAR {path}")
                    elif year != current_year:
                        print(f"Year mismatch {path} {year} {current_year}")
                        rv = 1
                    rv = 1



    raise SystemExit(rv)
